# Server Configuration
PORT=5000

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/rathore_heritage?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=rathore_heritage_jwt_secret_key_change_in_production

# Admin Initial Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Cloudinary Cloud Storage (Optional - falls back to local /uploads if not set)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

